#!/bin/bash

# List all PDF files in the current directory
list=$(ls -1 *.pdf 2>/dev/null)

# Check if any PDF files were found
if [ -z "$list" ]; then
    echo "No PDF files found in the current directory."
    exit 1
fi

# Check if pdftocairo is available
if ! command -v pdftocairo >/dev/null; then
    echo "pdftocairo not found. Please install poppler-utils."
    exit 1
fi

# Loop through PDFs and convert to SVG
for pdf_file in $list; do
    base_name=$(basename "$pdf_file" .pdf)

    # -svg robi SVG, -f 1 -l 1 = tylko pierwsza strona
    pdftocairo -svg -f 1 -l 1 "$pdf_file" "$base_name.svg"

    echo "Converted $pdf_file to $base_name.svg"
done

echo "Conversion complete."